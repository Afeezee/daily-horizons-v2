# ──────────────────────────────────────────────────────────────────────────
# Daily Horizons — environment variables (copy to .env.local for local dev;
# set these in the Vercel project dashboard for preview / production). Never
# commit real values.
# ──────────────────────────────────────────────────────────────────────────

# Neon Postgres
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Clerk
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=

# Groq (LLM)
GROQ_API_KEY=
AI_MODEL=qwen/qwen3.8-27b
AI_FALLBACK_MODEL=
GROQ_RPM_CEILING=25
GROQ_TPM_CEILING=7000
GROQ_TPD_CEILING=180000

# Web search providers (fact-checker + agent discovery)
SERPER_API_KEY=
TAVILY_API_KEY=
SEARCH_DAILY_CEILING=40
NEWS_DISCOVERY_DAILY_CEILING=150

# Image providers
UNSPLASH_ACCESS_KEY=
PEXELS_API_KEY=
PIXABAY_API_KEY=
POLLINATIONS_API_KEY=

# File storage (Vercel Blob)
BLOB_READ_WRITE_TOKEN=

# Email providers
RESEND_API_KEY=
BREVO_API_KEY=

# Admin bootstrap (comma-separated email allow-list)
ADMIN_EMAILS=

# Content agent
AGENT_SERVICE_KEY=
AGENT_AUTHOR_EMAIL=agent@dailyhorizons.app
AGENT_AUTHOR_DISPLAY_NAME=Daily Horizons Newsroom AI
AGENT_NEWS_QUERIES=Nigeria politics,Nigeria economy,Lagos,West Africa,world news,technology,business,sport
AGENT_CRON_SCHEDULE=0 */3 * * *
AGENT_MAX_ARTICLES_PER_RUN=5
AGENT_RUNS_PER_DAY=8

# Publishing policy (flip to true to require admin review before publish)
REQUIRE_ADMIN_APPROVAL=false

# Cron auth
CRON_SECRET=

# Legacy data migration (section 11)
LEGACY_MEDIA_HOST=
